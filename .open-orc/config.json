{
  "workflows": {
    "main": ["planner", "dev", "verifier"],
    "feature-implement": ["feature-planner", "feature-dev", "feature-verifier"],
    "bugfix-implement": ["bugfix-planner", "bugfix-dev", "bugfix-verifier"],
    "design-implement": ["figma-planner", "figma-dev", "figma-verifier"],
    "merge-resolve": ["merge-dev", "merge-verifier"]
  },
  "defaultWorkflow": "main",
  "maxIterations": 5,
  "retry": {
    "enabled": true,
    "maxAttempts": 2
  },
  "router": {
    "mode": "llm",
    "agent": "router"
  },
  "spec": {
    "enabled": true,
    "root": ".open-orc/specs"
  },
  "opencode": {
    "command": "opencode",
    "attach": null,
    "autoApprove": true
  },
  "delivery": {
    "enabled": true,
    "targetBranch": "current",
    "mergePaths": ["App.tsx", "src/**"],
    "excludePaths": ["AGENTS.md", ".open-orc/**"],
    "requireVerifierPass": true,
    "autoCommitInWorktree": true,
    "postMergeChecks": [],
    "conflictStrategy": "auto",
    "onFail": {
      "runMergeAgent": true,
      "maxAttempts": 1,
      "skipMergeVerifier": true,
      "workflow": "merge-resolve",
      "agents": ["merge-dev", "merge-verifier"]
    }
  }
}
