{
  "expo": {
    "name": "clothes-pos",
    "slug": "clothes-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.clothespos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Clothes POS to scan clothing QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Clothes POS to choose photos for clothing items.",
          "cameraPermission": "Allow Clothes POS to take photos of clothing items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pyidaungsu-Regular.ttf",
            "./assets/fonts/Pyidaungsu-Bold.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "e7482698-0a25-4c5b-b529-10b6cb99e8ea"
      }
    }
  }
}
